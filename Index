    function loadComarquesGeoJSON() {
        const geojsonUrl = 'https://geoserveis.icgc.cat/servei/catalunya/divisions-administratives/wfs?SERVICE=WFS&VERSION=2.0.0&REQUEST=GetFeature&TYPENAME=divisions_administratives_comarques_1000000&OUTPUTFORMAT=geojson&SRSNAME=EPSG:4326';

        fetch(geojsonUrl)
            .then(response => {
                if (!response.ok) throw new Error("Error carregant arxiu");
                return response.json();
            })
            .then(data => {
                catalunyaGeoJSONData = data;
                comarquesLayer = L.geoJSON(data, {
                    style: {
                        color: "#222222", 
                        weight: 1.5,      
                        opacity: 0.5, 
                        fillOpacity: 0    
                    },
                    interactive: false,
                    onEachFeature: function (feature, layer) {
                        let props = feature.properties;
                        let nomComarca = "Comarca";
                        
                        if (props) {
                            // Se comprueban todas las posibles variantes de nombres de propiedades devueltas por el ICGC
                            nomComarca = props.nomcomar || props.NOMCOMAR || props.nom_comarca || props.NOM_COMARCA || props.NOM_COM || props.nom || props.NOM || props.comarca || props.COMARCA || props.name || props.NAME || "Comarca";
                        }
                        
