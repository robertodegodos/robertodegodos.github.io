<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Radar Meteocat Animat</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <!-- Custom CSS -->
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }
        #map {
            height: 100%;
            width: 100%;
            z-index: 1;
        }
        
        /* Botón para desplegar el menú */
        .menu-toggle-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1001;
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 10px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
            transition: background 0.2s;
        }
        .menu-toggle-btn:hover { background: #f0f0f0; }

        /* Botón para activar/desactivar pantalla completa (al lado del menú) */
        .fullscreen-toggle-btn {
            position: absolute;
            top: 20px;
            right: 74px;
            z-index: 1001;
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 10px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
            transition: background 0.2s;
        }
        .fullscreen-toggle-btn:hover { background: #f0f0f0; }

        /* Contenedor Superior Derecha (Botones y Sliders) */
        .controls-container {
            position: absolute;
            top: 70px; /* Desplazado hacia abajo para no tapar el botón del menú */
            right: 20px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.95);
            padding: 15px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 210px;
            transition: opacity 0.3s, transform 0.3s;
            transform-origin: top right;
            max-height: 85vh;
            overflow-y: auto;
        }
        
        /* Clase para ocultar elementos de la UI */
        .hidden {
            display: none !important;
        }

        .control-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #333;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: -5px;
            margin-top: 5px;
        }
        .control-label:first-child {
            margin-top: 0;
        }
        
        /* Estilo para el selector de mapa base */
        .map-select {
            background: white;
            border: 1px solid #ddd;
            padding: 8px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            width: 100%;
            font-family: inherit;
            color: #333;
            outline: none;
        }
        .map-select:hover { border-color: #0084ff; }

        .toggle-btn {
            background: white;
            border: 1px solid #ddd;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .toggle-btn:hover { background: #f5f5f5; }
        .toggle-btn.active {
            background: #0084ff;
            color: white;
            border-color: #0084ff;
        }

        /* Estilos de los Sliders de Opacidad */
        .opacity-control {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 0.8rem;
            color: #444;
            margin-top: 2px;
        }
        .opacity-control label {
            display: flex;
            justify-content: space-between;
            font-weight: 500;
        }
        .opacity-control input[type="range"] {
            width: 100%;
            cursor: pointer;
        }
        hr {
            border: 0;
            border-top: 1px solid #ddd;
            margin: 5px 0;
            width: 100%;
        }

        /* Estilo para los nombres de las comarcas en el mapa */
        .comarque-label {
            background: none !important;
            border: none !important;
            box-shadow: none !important;
            font-size: var(--comarca-font-size, 10px); /* Controlado por variable CSS */
            font-weight: bold;
            color: #222;
            text-shadow: 1px 1px 2px #fff, -1px -1px 2px #fff, 1px -1px 2px #fff, -1px 1px 2px #fff;
            text-align: center;
            white-space: nowrap;
        }

        /* Contenedor Inferior (Línea de tiempo / Slider) */
        .timeline-container {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            background: rgba(255, 255, 255, 0.95);
            padding: 15px 20px;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            gap: 15px;
            width: 50%;
            max-width: 500px;
        }
        .play-btn {
            background: #0084ff;
            color: white;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.1s, background 0.2s;
        }
        .play-btn:active { transform: scale(0.95); }
        .play-btn:hover { background: #006bce; }
        
        .slider-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        #timestamp-display {
            font-size: 1rem;
            font-weight: bold;
            color: #333;
            text-align: center;
        }
        .timeline-container input[type="range"] {
            width: 100%;
            cursor: pointer;
        }

        /* Rendering para imágenes de radar */
        .radar-pixelated {
            image-rendering: -moz-crisp-edges;
            image-rendering: -webkit-crisp-edges;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            -ms-interpolation-mode: nearest-neighbor;
        }

        /* Mode "Només núvols": es fusionen les tessel·les del satèl·lit
           (GeoColour) amb el mapa base amb mix-blend-mode "multiply", després
           d'invertir-ne els tons (filter). Amb "multiply", un píxel blanc de
           la capa deixa el mapa base intacte (= invisible) i un píxel gris
           l'enfosqueix proporcionalment; per això cal que la terra/mar
           (originalment foscos) es converteixin en blancs (invisibles) i els
           núvols (originalment blancs) es converteixin en un gris clar ben
           visible. És la tècnica contrària a fer-ho amb "screen" —que amb un
           mapa base clar sempre dona blanc, per molt clars o foscos que
           siguin els núvols— i per tant funciona igual de bé sigui quin
           sigui el color del mapa base. */
        body.clouds-only-active .satellite-tile {
            mix-blend-mode: multiply;
            filter: grayscale(1) contrast(1.5) invert(0.7) brightness(1.8);
        }

        /* MARCADOR D'UBICACIÓ DE L'USUARI (estil "punt blau" tipus Google Maps) */
        .user-location-marker-wrapper {
            position: relative;
            width: 24px;
            height: 24px;
        }
        .user-location-pulse {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 24px;
            height: 24px;
            margin: -12px 0 0 -12px;
            border-radius: 50%;
            background: rgba(26, 115, 232, 0.35);
            animation: user-location-pulse 2.2s ease-out infinite;
            z-index: 1;
            pointer-events: none;
        }
        @keyframes user-location-pulse {
            0% { transform: scale(0.4); opacity: 0.8; }
            100% { transform: scale(2.4); opacity: 0; }
        }
        .user-location-dot {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 16px;
            height: 16px;
            margin: -8px 0 0 -8px;
            background: #1a73e8;
            border: 2px solid #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.15), 0 2px 4px rgba(0,0,0,0.35);
            z-index: 3;
        }
        /* Con d'orientació: triangle amb l'àpex al centre exacte del punt blau,
           rotat segons el rumb del dispositiu (brúixola o GPS en moviment). */
        .user-heading-cone {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 76px;
            height: 76px;
            margin: -76px 0 0 -38px;
            transform-origin: 50% 100%;
            transform: rotate(0deg);
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 2;
            pointer-events: none;
            clip-path: polygon(50% 100%, 18% 6%, 82% 6%);
            background: radial-gradient(circle at 50% 100%, rgba(26,115,232,0.55) 0%, rgba(26,115,232,0.22) 55%, rgba(26,115,232,0) 100%);
        }
        .user-heading-cone.active { opacity: 1; }

        /* PANELL EMERGENT DE PRECIPITACIÓ ACUMULADA (clic al mapa) */
        .precip-popup .leaflet-popup-content-wrapper {
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.25);
        }
        .precip-popup .leaflet-popup-content {
            margin: 12px 14px;
        }
        .precip-popup-content {
            min-width: 250px;
            font-family: inherit;
        }
        .precip-popup-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 4px;
        }
        .precip-popup-total {
            font-size: 1.9rem;
            font-weight: 800;
            color: #0084ff;
            line-height: 1.1;
        }
        .precip-popup-total span {
            font-size: 1rem;
            font-weight: 600;
            color: #666;
        }
        .precip-popup-subtitle {
            font-size: 0.78rem;
            color: #666;
            margin-bottom: 8px;
        }
        .precip-popup-disclaimer {
            font-size: 0.7rem;
            color: #999;
            margin-top: 8px;
            line-height: 1.35;
        }
        .precip-popup-error {
            font-size: 0.85rem;
            color: #444;
            max-width: 240px;
            line-height: 1.4;
        }
        .precip-loading-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px 0 4px;
        }
        .precip-loading-spinner {
            width: 26px;
            height: 26px;
            border: 3px solid #e0e0e0;
            border-top-color: #0084ff;
            border-radius: 50%;
            animation: precip-spin 0.8s linear infinite;
            margin-bottom: 8px;
        }
        .precip-loading-text {
            font-size: 0.8rem;
            color: #666;
        }
        @keyframes precip-spin {
            to { transform: rotate(360deg); }
        }

        /* LEYENDA (ESQUINA INF. IZQ) */
        .legend-container {
            position: absolute;
            bottom: 30px;
            left: 20px;
            z-index: 1000;
            background: rgba(245, 245, 245, 0.95);
            padding: 12px 18px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(5px);
            min-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .legend-title {
            font-size: 0.85rem;
            color: #4A6382; 
            text-align: center;
            margin-bottom: 2px;
        }
        .legend-bar-container {
            width: 100%;
        }
        .legend-bar {
            display: flex;
            height: 10px;
            border: 1px solid #777;
            width: 100%;
        }
        .color-block {
            flex: 1;
            border-right: 1px solid rgba(0,0,0,0.1);
        }
        .color-block:last-child {
            border-right: none;
        }
        .legend-labels {
            position: relative;
            height: 15px;
            margin-top: 4px;
        }
        .legend-label-text {
            position: absolute;
            font-size: 0.75rem;
            color: #4A6382;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        /* Notificación de error (toast) */
        #notice-toast {
            display: none;
            position: absolute;
            bottom: 90px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(190, 40, 40, 0.95);
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            z-index: 2000;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            max-width: 80%;
            text-align: center;
        }

        /* BUSCADOR DE LOCALITATS (SUPERIOR CENTRAT) */
        .search-container {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) scale(0.7);
            transform-origin: top center;
            z-index: 1001;
            width: min(90vw, 420px);
        }
        .search-box {
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.97);
            border-radius: 24px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
            padding: 6px 8px 6px 16px;
        }
        .search-box svg {
            flex-shrink: 0;
            color: #666;
        }
        #location-search {
            flex-grow: 1;
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.95rem;
            padding: 8px 8px;
            font-family: inherit;
            color: #222;
            min-width: 0;
        }
        #search-clear-btn {
            border: none;
            background: none;
            cursor: pointer;
            color: #999;
            display: none;
            padding: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        #search-clear-btn:hover { background: #f0f0f0; color: #555; }
        #search-clear-btn.visible { display: flex; align-items: center; justify-content: center; }

        #search-suggestions {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: white;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            max-height: 300px;
            overflow-y: auto;
            display: none;
        }
        #search-suggestions.visible { display: block; }
        .suggestion-item {
            padding: 10px 16px;
            cursor: pointer;
            font-size: 0.88rem;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            line-height: 1.3;
        }
        .suggestion-item:last-child { border-bottom: none; }
        .suggestion-item:hover, .suggestion-item.highlighted { background: #f0f7ff; }
        .suggestion-item svg { flex-shrink: 0; margin-top: 2px; color: #0084ff; }
        .suggestion-empty, .suggestion-loading {
            padding: 12px 16px;
            font-size: 0.85rem;
            color: #888;
            text-align: center;
        }

        /* MARCADOR DE CERCA (CERCLE, ESTIL SIMILAR AL PUNT D'UBICACIÓ) */
        .search-marker-icon {
            position: relative;
            width: 18px;
            height: 18px;
        }
        .search-marker-icon .marker-dot {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 18px;
            height: 18px;
            margin: -9px 0 0 -9px;
            border: 2.5px solid #ffffff;
            border-radius: 50%;
            box-sizing: border-box;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.15), 0 2px 4px rgba(0,0,0,0.4);
        }
        .search-marker-icon .marker-menu {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            display: none;
            gap: 6px;
            background: white;
            padding: 5px;
            border-radius: 20px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.3);
            white-space: nowrap;
        }
        .search-marker-icon:hover .marker-menu {
            display: flex;
        }
        .marker-menu button {
            border: none;
            background: #f2f2f2;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            cursor: pointer;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s;
        }
        .marker-menu .btn-remove:hover { background: #ffd6d6; }
        .marker-menu .btn-pin:hover { background: #ffe9b3; }
        .marker-menu .btn-pin.is-pinned { background: #ffcf5c; }
        .search-marker-icon .pin-label {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.75);
            color: white;
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 6px;
            white-space: nowrap;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            display: none;
        }
        .search-marker-icon:hover .pin-label {
            display: block;
        }

        /* MAPA DE PLUJA ACUMULADA (overlay de tota la pantalla) */
        .accum-rain-loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2000;
            background: rgba(255, 255, 255, 0.97);
            padding: 26px 34px;
            border-radius: 14px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
            text-align: center;
            max-width: 260px;
        }
        .accum-rain-spinner {
            width: 36px;
            height: 36px;
            border: 4px solid #e0e0e0;
            border-top-color: #0084ff;
            border-radius: 50%;
            margin: 0 auto 14px;
            animation: precip-spin 0.8s linear infinite;
        }
        .accum-rain-loading-text {
            font-size: 0.9rem;
            font-weight: 700;
            color: #333;
            line-height: 1.4;
        }
        .accum-rain-loading-subtext {
            font-size: 0.75rem;
            font-weight: 400;
            color: #777;
            margin-top: 4px;
        }
        .accum-rain-close-btn {
            position: absolute;
            top: 20px;
            right: 74px;
            z-index: 2001;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.97);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #333;
            transition: background 0.2s, transform 0.1s;
        }
        .accum-rain-close-btn:hover { background: #f5f5f5; }
        .accum-rain-close-btn:active { transform: scale(0.95); }
        .accum-rain-title-badge {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2001;
            background: rgba(255, 255, 255, 0.97);
            padding: 9px 20px;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
            font-size: 0.85rem;
            font-weight: 700;
            color: #333;
            text-align: center;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div id="map"></div>
    
    <!-- Botón de Menú para mostrar/ocultar panel -->
    <button id="menu-toggle" class="menu-toggle-btn" title="Opcions del Mapa" aria-label="Obrir o tancar el menú d'opcions" aria-expanded="false" aria-controls="controls-menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>

    <!-- Botón de Pantalla Completa -->
    <button id="fullscreen-toggle" class="fullscreen-toggle-btn" title="Pantalla completa" aria-label="Activar pantalla completa" aria-pressed="false">
        <svg id="fullscreen-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
    </button>

    <!-- Buscador de localitats -->
    <div class="search-container">
        <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="location-search" placeholder="Cerca una localitat o lloc..." autocomplete="off" aria-label="Cerca una localitat o lloc" role="combobox" aria-expanded="false" aria-controls="search-suggestions">
            <button id="search-clear-btn" title="Esborrar" aria-label="Esborrar la cerca">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div id="search-suggestions" role="listbox"></div>
    </div>

    <!-- Controles Superiores -->
    <div id="controls-menu" class="controls-container hidden">
        
        <span class="control-label">Mapa Base</span>
        <select id="basemap-select" class="map-select" aria-label="Selecciona el mapa base">
            <option value="carto">Carto Light (Defecte)</option>
            <option value="osm">OpenStreetMap</option>
            <option value="google">Google Maps</option>
            <option value="pnoa">Ortofoto PNOA (IGN)</option>
            <option value="hillshade">Relleu Sombrejat (Hillshade)</option>
        </select>
        
        <hr>

        <span class="control-label">Capes Meteocat</span>
        <button id="btn-rain" class="toggle-btn active" aria-pressed="true">
            Radar
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
