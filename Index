    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Chart.js (per a la gràfica d'acumulació de precipitació) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>

    
    <!-- RADAR SCRIPT -->
    <script>
    const CONFIG = {
        INTERVAL_MINUTES: 6,
        TIMELINE_LENGTH: 27, // 27 x 6min ≈ 2,7 hores de recorregut
        ACCUM_FRAME_COUNT: 11, // 11 imatges = 10 intervals x 6min = 60 min = 1 hora exacta d'acumulació
        CENTER: [41.7, 1.8],
        ZOOM: 8,
        URLS: {
            rain: "https://static-m.meteo.cat/tiles/radar/{any}/{mes}/{dia}/{hora}/{minut}/{z}/000/000/{x}/000/000/{y}.png",
            snow: "https://static-m.meteo.cat/tiles/plujaneu/{any}/{mes}/{dia}/{hora}/{minut}/{z}/000/000/{x}/000/000/{y}.png"
        },
        ANIMATION_SPEED: 200,
        LOOP_PAUSE_MS: 1000 // pausa al arribar al final abans de reiniciar el bucle
    };

    const LEGEND_DATA = {
        rain: {
            title: "Intensitat de precipitació",
            colors: [
                "#7E1BCE", "#4214C9", "#151AE8", "#0328FF", "#01DEFE", 
                "#00FFB2", "#08FF36", "#64FF00", "#A8FF00", "#EEFF00", 
                "#FDB700", "#FF7B00", "#FF3B00", "#E40000", "#C5002C", 
                "#ED006A", "#F300C3", "#E300FF", "#FFFFFF"
            ],
            labels: [
                { text: "feble", position: "5%" },
                { text: "moderada", position: "33%" },
                { text: "forta", position: "66%" },
                { text: "calamarsa", position: "95%" }
            ]
        },
        snow: {
            title: "Tipus de precipitació",
            colors: [
                "#F9C7CB", "#F49F9F", "#EE7777", "#E94F4F", "#D73030", "#A61C1C", 
                "#DDF5CD", "#BDF2AA", "#91F080", "#54E747", "#1EAA14", "#098402", 
                "#CAECFA", "#9FCAE6", "#73A8D3", "#4A87C1", "#2264AC", "#0D4293"  
            ],
            labels: [
                { text: "Pluja", position: "15%" },
                { text: "Aiguaneu", position: "50%" },
                { text: "Neu", position: "85%" }
            ]
        },
        accum: {
            title: "Pluja acumulada (mm)",
            colors: [
                "#7E1BCE", "#4214C9", "#151AE8", "#0328FF", "#01DEFE", 
                "#00FFB2", "#08FF36", "#64FF00", "#A8FF00", "#EEFF00", 
                "#FDB700", "#FF7B00", "#FF3B00", "#E40000", "#C5002C", 
                "#ED006A", "#F300C3", "#E300FF", "#FFFFFF"
            ],
            labels: [
                { text: "0,1 mm", position: "3%" },
                { text: "5 mm", position: "27%" },
                { text: "26 mm", position: "55%" },
                { text: "100+ mm", position: "88%" }
            ]
        }
    };

    // Escala aproximada d'intensitat (mm/h) associada a cada color de la llegenda del radar.
    // És una estimació orientativa (no un valor oficial de Meteocat) basada en escales
    // habituals d'intensitat de precipitació per radar.
    const RAIN_INTENSITY_MMH = [
        0.1, 0.2, 0.5, 1, 1.5, 2, 3, 4, 5, 6,
        8, 10, 15, 20, 30, 40, 60, 80, 100
    ];

    function hexToRgb(hex) {
        hex = hex.replace('#', '');
        const bigint = parseInt(hex, 16);
        return [(bigint >> 16) & 255, (bigint >> 8) & 255, bigint & 255];
    }

    const RAIN_COLOR_RGB = LEGEND_DATA.rain.colors.map(hexToRgb);

    let map;
    let currentMode = 'rain';
    let appliedMode = null;
    let visibleTimestamp = null;
    let isApplyingLayer = false;
    
    let timelineDates = [];
    let layerCache = {};
    let currentIndex = CONFIG.TIMELINE_LENGTH - 1;
    let playInterval;
    let loopRestartTimeout;
    let isPlaying = false;
    
    let currentRadarOpacity = 0.5;

    // Configuració de la capa de satèl·lit en directe (núvols).
    // S'utilitza el servei WMS públic i gratuït d'EUMETSAT (EUMETView), que
    // serveix les imatges del satèl·lit geoestacionari Meteosat Third
    // Generation (MTG), producte GeoColour RGB, amb resolució d'1 km i
    // actualització cada 10 minuts. El servidor accepta qualsevol data/hora
    // (paràmetre TIME) i "arrodoneix" automàticament al fotograma disponible
    // més proper (nearestValue), per això no cal descarregar cap llista de
    // fotogrames: només calculem la marca de temps que volem mostrar.
    const SATELLITE_CONFIG = {
        WMS_URL: 'https://view.eumetsat.int/geoserver/wms',
        LAYER: 'mtg_fd:rgb_geocolour',
        STEP_MINUTES: 10, // Cadència de publicació de fotogrames del MTG
        REFRESH_INTERVAL_MS: 2 * 60 * 1000, // Es comprova cada 2 min si toca mostrar un fotograma més nou
        MAX_CACHED_FRAMES: 24, // Nombre màxim de capes simultànies en memòria (cobreix tota la línia de temps del radar)
        Z_INDEX: 60 // Per sota del radar (100), per poder comparar-los superposats
    };
    let satelliteEnabled = false;
    let satelliteLayerCache = {}; // clau: ISO string (arrodonit als 10 min) -> L.TileLayer.WMS
    let satelliteActiveTimeKey = null;
    let currentSatelliteOpacity = 0.5;
    let satelliteRefreshTimer = null;
    let satelliteRequestToken = 0; // per descartar respostes de fotogrames obsolets si l'usuari mou el slider ràpid

    let comarquesLayer; 
    let municipisLayer = null; 
    let nomsComarquesLayer = L.layerGroup(); 
    
    let userLocationMarker = null;
    let userAccuracyCircle = null;
    let watchPositionId = null;
    let deviceHeading = null;
    let headingListenerActive = false;
    let headingEventName = null;

    // Estat del càlcul de precipitació acumulada (clic al mapa)
    let precipPopup = null;
    let precipChartInstance = null;
    let precipRequestId = 0;

    // Estat del "Mapa de pluja acumulada" (overlay pixelat sobre tot Catalunya)
    let catalunyaGeoJSONData = null;
    let accumRainOverlay = null;
    let accumRainRequestId = 0;
    let currentAccumRainOpacity = 0.85;

    // Escala d'acumulació (mm en 1h) associada a la mateixa gamma de colors del radar
    const ACCUM_BINS_MM = [0.1, 1, 2, 3, 5, 7, 10, 13, 17, 21, 26, 32, 40, 50, 65, 80, 100, 130, 160];
    const ACCUM_GRAY_RGB = [175, 175, 175]; // zones sense pluja (dins de Catalunya)

    const baseMaps = {
        carto: L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
            subdomains: 'abcd',
            maxZoom: 20
        }),
        osm: L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
        }),
        google: L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
            attribution: '&copy; Google Maps',
            maxZoom: 20
        }),
        pnoa: L.tileLayer.wms('https://www.ign.es/wms-inspire/pnoa-ma', {
            layers: 'OI.OrthoimageCoverage',
            format: 'image/jpeg',
            transparent: false,
            attribution: '&copy; IGN PNOA',
            maxZoom: 20
        }),
        hillshade: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}', {
            attribution: '&copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
            maxZoom: 16
        })
    };
    
    let currentBasemap = baseMaps.carto;

    const MeteocatTileLayer = L.TileLayer.extend({
        getTileUrl: function (coords) {
            if (!coords) return "";
            let y = coords.y;
            if (this.options.tms) {
                y = this._globalTileRange.max.y - coords.y;
            }
            const pad = (val, len) => String(val).padStart(len, '0');
            
            let url = this._url;
            url = url.replace('{z}', pad(coords.z, 2));
            url = url.replace('{x}', pad(coords.x, 3));
            url = url.replace('{y}', pad(y, 3));
            return url;
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        initMap();
        updateLegendUI(); 
        checkLatestImage().then(scheduleNextRadarCheck);
        initSearch();
        initFullscreenToggle();

        const menuBtn = document.getElementById('menu-toggle');
        const controlsMenu = document.getElementById('controls-menu');
        menuBtn.addEventListener('click', () => {
            const willShow = controlsMenu.classList.contains('hidden');
            controlsMenu.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', String(willShow));
        });

        const toggleLegendCheckbox = document.getElementById('toggle-legend');
        const legendContainer = document.getElementById('legend-container');
        toggleLegendCheckbox.addEventListener('change', (e) => {
            if (e.target.checked) {
                legendContainer.classList.remove('hidden');
            } else {
                legendContainer.classList.add('hidden');
            }
        });

        const toggleMunicipisCheckbox = document.getElementById('toggle-municipis');
        toggleMunicipisCheckbox.addEventListener('change', (e) => {
            if (e.target.checked) {
                loadMunicipisGeoJSON();
            } else {
                if (municipisLayer) {
                    map.removeLayer(municipisLayer);
                    municipisLayer = null;
                }
            }
        });

        const toggleLocationCheckbox = document.getElementById('toggle-location');
        toggleLocationCheckbox.addEventListener('change', (e) => {
            if (e.target.checked) {
                if (navigator.geolocation) {
                    watchPositionId = navigator.geolocation.watchPosition(
                        (position) => {
                            const lat = position.coords.latitude;
                            const lng = position.coords.longitude;
                            const accuracy = (typeof position.coords.accuracy === 'number') ? position.coords.accuracy : null;

                            if (!userLocationMarker) {
                                userLocationMarker = L.marker([lat, lng], {
                                    icon: buildUserLocationIcon(),
                                    interactive: false,
                                    zIndexOffset: 1000
                                }).addTo(map);
                            } else {
                                userLocationMarker.setLatLng([lat, lng]);
                            }

                            // Cercle de precisió del GPS (radi real en metres, escala amb el zoom)
                            if (accuracy !== null && !isNaN(accuracy)) {
                                if (!userAccuracyCircle) {
                                    userAccuracyCircle = L.circle([lat, lng], {
                                        radius: accuracy,
                                        color: '#1a73e8',
                                        weight: 1,
                                        opacity: 0.35,
                                        fillColor: '#1a73e8',
                                        fillOpacity: 0.10,
                                        interactive: false
                                    }).addTo(map);
                                } else {
                                    userAccuracyCircle.setLatLng([lat, lng]);
                                    userAccuracyCircle.setRadius(accuracy);
                                }
                            }

                            // Si no hi ha brúixola activa, aprofitem el rumb GPS (només fiable en moviment)
                            if (!headingListenerActive && typeof position.coords.heading === 'number' && !isNaN(position.coords.heading)) {
                                deviceHeading = position.coords.heading;
                            }
                            updateMarkerHeading();
                        },
                        (error) => {
                            console.error("Error obtenint la ubicació:", error);
                            showNotice("No s'ha pogut obtenir la ubicació. Comprova els permisos del navegador.");
                            toggleLocationCheckbox.checked = false;
                        },
                        { enableHighAccuracy: true, maximumAge: 10000, timeout: 5000 }
                    );
                    startCompass();
                } else {
                    showNotice("El teu navegador no suporta la geolocalització.");
                    toggleLocationCheckbox.checked = false;
                }
            } else {
                if (watchPositionId !== null) {
                    navigator.geolocation.clearWatch(watchPositionId);
                    watchPositionId = null;
                }
                if (userLocationMarker) {
                    map.removeLayer(userLocationMarker);
                    userLocationMarker = null;
                }
                if (userAccuracyCircle) {
                    map.removeLayer(userAccuracyCircle);
                    userAccuracyCircle = null;
                }
                stopCompass();
            }
        });

        document.getElementById('basemap-select').addEventListener('change', (e) => {
            map.removeLayer(currentBasemap);
            currentBasemap = baseMaps[e.target.value];
            currentBasemap.addTo(map);
            
            for (let key in satelliteLayerCache) satelliteLayerCache[key].bringToFront();
            for (let key in layerCache) {
                layerCache[key].bringToFront();
            }
            if (comarquesLayer) comarquesLayer.bringToFront();
            if (municipisLayer) municipisLayer.bringToFront();
            if (userAccuracyCircle) userAccuracyCircle.bringToFront();
            if (userLocationMarker) userLocationMarker.bringToFront();
        });

        document.getElementById('btn-rain').addEventListener('click', () => setMode('rain'));
        document.getElementById('btn-snow').addEventListener('click', () => setMode('snow'));

        document.getElementById('btn-satellite').addEventListener('click', () => {
            const btn = document.getElementById('btn-satellite');
            const willEnable = !satelliteEnabled;
            btn.classList.toggle('active', willEnable);
            btn.setAttribute('aria-pressed', String(willEnable));
            document.getElementById('satellite-timestamp-note').classList.toggle('hidden', !willEnable);
            if (willEnable) {
                enableSatellite();
            } else {
                disableSatellite();
            }
        });

        // "Només núvols": fusiona (mix-blend-mode: screen) les tessel·les del
        // satèl·lit amb el mapa base, de manera que el mar i la terra —molt
        // més foscos que els núvols dins el compost GeoColour— pràcticament
        // desapareixen i només es veuen els núvols. Actiu per defecte.
        document.body.classList.add('clouds-only-active');
        document.getElementById('btn-clouds-only').addEventListener('click', () => {
            const btn = document.getElementById('btn-clouds-only');
            const willEnable = !document.body.classList.contains('clouds-only-active');
            document.body.classList.toggle('clouds-only-active', willEnable);
            btn.classList.toggle('active', willEnable);
            btn.setAttribute('aria-pressed', String(willEnable));
        });

        // Throttle basat en requestAnimationFrame: evita que cada micro-moviment
        // d'un slider dispari immediatament una actualització del DOM/Leaflet.
        // Es queda amb els últims arguments rebuts i només executa `fn` una
        // vegada per frame, cosa que alleugereix molt els dispositius mòbils
        // de gamma baixa sense afegir latència perceptible.
        function rafThrottle(fn) {
            let rafId = null;
            let lastArgs = null;
            return function (...args) {
                lastArgs = args;
                if (rafId === null) {
                    rafId = requestAnimationFrame(() => {
                        rafId = null;
                        fn.apply(this, lastArgs);
                    });
                }
            };
        }

        document.getElementById('opacity-satellite').addEventListener('input', rafThrottle((e) => {
            currentSatelliteOpacity = parseInt(e.target.value) / 100;
            document.getElementById('val-opacity-satellite').textContent = e.target.value + '%';
            if (satelliteEnabled) renderActiveSatelliteFrame();
        }));

        document.getElementById('btn-accum-rain').addEventListener('click', () => {
            if (accumRainOverlay) {
                closeAccumulatedRainMap();
            } else {
                generateAccumulatedRainMap();
            }
        });

        document.getElementById('accum-rain-close-btn').addEventListener('click', () => {
            closeAccumulatedRainMap();
        });
        document.getElementById('btn-play').addEventListener('click', () => togglePlay());
        
        const sliderTime = document.getElementById('time-slider');
        sliderTime.max = CONFIG.TIMELINE_LENGTH - 1;
        sliderTime.addEventListener('input', (e) => {
            currentIndex = parseInt(e.target.value);
            renderActiveLayer();
            if (isPlaying) togglePlay(false);
        });

        document.getElementById('opacity-radar').addEventListener('input', rafThrottle((e) => {
            currentRadarOpacity = parseInt(e.target.value) / 100;
            document.getElementById('val-opacity-radar').textContent = e.target.value + '%';
            renderActiveLayer(); 
        }));

        document.getElementById('opacity-comarques').addEventListener('input', rafThrottle((e) => {
            let opacityVal = parseInt(e.target.value) / 100;
            document.getElementById('val-opacity-comarques').textContent = e.target.value + '%';
            if (comarquesLayer) {
                comarquesLayer.setStyle({ opacity: opacityVal });
            }
        }));

        document.getElementById('opacity-municipis').addEventListener('input', rafThrottle((e) => {
