    const FULLSCREEN_ENTER_ICON = '<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>';
    const FULLSCREEN_EXIT_ICON = '<path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>';

    function isDocumentFullscreen() {
        return !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);
    }

    function requestFullscreenCompat(el) {
        const fn = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen;
        if (fn) return fn.call(el);
        return Promise.reject(new Error('API no suportada'));
    }

    function exitFullscreenCompat() {
        const fn = document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen;
        if (fn) return fn.call(document);
        return Promise.reject(new Error('API no suportada'));
    }

    function updateFullscreenButtonUI() {
        const btn = document.getElementById('fullscreen-toggle');
        const icon = document.getElementById('fullscreen-icon');
        if (!btn || !icon) return;
        const active = isDocumentFullscreen();
        icon.innerHTML = active ? FULLSCREEN_EXIT_ICON : FULLSCREEN_ENTER_ICON;
        btn.title = active ? 'Sortir de pantalla completa' : 'Pantalla completa';
        btn.setAttribute('aria-label', active ? 'Sortir de pantalla completa' : 'Activar pantalla completa');
        btn.setAttribute('aria-pressed', String(active));
    }

    function initFullscreenToggle() {
        const btn = document.getElementById('fullscreen-toggle');
        if (!btn) return;

        btn.addEventListener('click', () => {
            if (!isDocumentFullscreen()) {
                requestFullscreenCompat(document.documentElement).catch((err) => {
                    console.error('Error activant pantalla completa:', err);
                    showNotice("No s'ha pogut activar la pantalla completa en aquest dispositiu.");
                });
            } else {
                exitFullscreenCompat().catch((err) => {
                    console.error('Error sortint de pantalla completa:', err);
                });
            }
        });

        ['fullscreenchange', 'webkitfullscreenchange', 'msfullscreenchange'].forEach((evt) => {
            document.addEventListener(evt, updateFullscreenButtonUI);
        });

        updateFullscreenButtonUI();
    }

