    function setMode(mode) {
        if (currentMode === mode) return;
        currentMode = mode;
        
        document.getElementById('btn-rain').classList.toggle('active', mode === 'rain');
        document.getElementById('btn-rain').setAttribute('aria-pressed', String(mode === 'rain'));
        document.getElementById('btn-snow').classList.toggle('active', mode === 'snow');
        document.getElementById('btn-snow').setAttribute('aria-pressed', String(mode === 'snow'));
        
        updateLegendUI(); 
        clearCache();
        document.getElementById('timestamp-display').textContent = "Carregant nou mode...";
        // Cancel·lem qualsevol sondeig pendent per evitar una comprovació
        // duplicada i reiniciem el bucle des de zero amb el ritme base.
        clearTimeout(radarPollTimer);
        checkLatestImage().then(scheduleNextRadarCheck);
    }

    function roundToInterval(date) {
        const d = new Date(date);
        let minutes = d.getUTCMinutes();
        d.setUTCMinutes(minutes - (minutes % CONFIG.INTERVAL_MINUTES));
        d.setUTCSeconds(0);
        d.setUTCMilliseconds(0);
        return d;
    }

    // Retorna `true` si s'ha trobat i aplicat una imatge vàlida, `false` en cas
    // contrari (sense resultats o error de xarxa). El booleà l'utilitza el bucle
    // de sondeig (scheduleNextRadarCheck) per decidir si allargar l'espera.
    async function checkLatestImage() {
        if (isApplyingLayer) return true;
        isApplyingLayer = true;

        let start = roundToInterval(new Date());
        let candidates = [];
        for (let i = 0; i < 5; i++) { 
            candidates.push(new Date(start.getTime() - (i * CONFIG.INTERVAL_MINUTES * 60000)));
        }

        const checks = candidates.map(async (date) => {
            const url = getTestUrl(date);
            const exists = await checkImageExists(url);
            return { date, exists };
        });

        let success = false;
        try {
            const results = await Promise.all(checks);
            const winner = results.find(r => r.exists);

            if (winner) {
                success = true;
                const latestDate = winner.date;
                if (!visibleTimestamp || latestDate.getTime() !== visibleTimestamp.getTime() || appliedMode !== currentMode) {
                    visibleTimestamp = latestDate;
                    appliedMode = currentMode;
                    updateTimeline(latestDate);
                }
            } else {
                showNotice("No s'han trobat imatges recents del radar. Es tornarà a provar en breu.");
            }
        } catch (e) {
            console.error("Error al buscar imatges", e);
            showNotice("Error comprovant les últimes imatges del radar.");
        }

        isApplyingLayer = false;
        return success;
    }

    // Sondeig amb reconnexió exponencial: mentre les comprovacions tinguin
    // èxit es manté el ritme base (60 s). Si la xarxa falla o no hi ha
    // imatges noves, l'espera es va doblant (fins a un màxim de 5 min) per no
    // castigar una connexió caiguda amb peticions constants. En quant torna a
    // funcionar, el ritme torna immediatament a la base.
    const RADAR_POLL_BASE_MS = 60 * 1000;
    const RADAR_POLL_MAX_MS = 5 * 60 * 1000;
    let radarPollDelay = RADAR_POLL_BASE_MS;
    let radarPollTimer = null;

    function scheduleNextRadarCheck(success) {
        radarPollDelay = success
            ? RADAR_POLL_BASE_MS
            : Math.min(radarPollDelay * 2, RADAR_POLL_MAX_MS);
        clearTimeout(radarPollTimer);
        radarPollTimer = setTimeout(runRadarPollLoop, radarPollDelay);
    }

    async function runRadarPollLoop() {
        const success = await checkLatestImage();
        scheduleNextRadarCheck(success);
    }

    function updateTimeline(latestDate) {
        let newDates = [];
        for (let i = CONFIG.TIMELINE_LENGTH - 1; i >= 0; i--) {
            newDates.push(new Date(latestDate.getTime() - i * CONFIG.INTERVAL_MINUTES * 60000));
        }
        timelineDates = newDates;

        for (let key in layerCache) {
            if (!newDates.find(d => d.getTime() == key)) {
                map.removeLayer(layerCache[key]);
                delete layerCache[key];
            }
        }

        newDates.forEach((date) => {
            let timeKey = date.getTime();
            if (!layerCache[timeKey]) {
                const urlWithTime = formatUrl(CONFIG.URLS[currentMode], date);
                let layer = new MeteocatTileLayer(urlWithTime, {
                    opacity: 0, 
                    attribution: 'Meteocat',
                    zIndex: 100, 
                    tms: true,
                    maxNativeZoom: 7,
                    className: 'radar-pixelated'
                });
                layer.addTo(map);
                layerCache[timeKey] = layer;
            }
        });

        const slider = document.getElementById('time-slider');
        slider.disabled = false;

        if (satelliteEnabled) preloadSatelliteFrames();

        if (!isPlaying) {
            currentIndex = CONFIG.TIMELINE_LENGTH - 1;
            slider.value = currentIndex;
            renderActiveLayer();
        }
    }

    function renderActiveLayer() {
        if (timelineDates.length === 0) return;
        let activeDate = timelineDates[currentIndex];

        for (let key in layerCache) {
            if (key == activeDate.getTime()) {
                layerCache[key].setOpacity(currentRadarOpacity);
                layerCache[key].bringToFront(); 
            } else {
                layerCache[key].setOpacity(0);
            }
        }

        if (satelliteEnabled) renderActiveSatelliteFrame(activeDate);

        if (comarquesLayer) comarquesLayer.bringToFront();
        if (municipisLayer) municipisLayer.bringToFront();
        if (userAccuracyCircle) userAccuracyCircle.bringToFront();
        if (userLocationMarker) userLocationMarker.bringToFront();

        updateTimestampDisplay(activeDate);
    }

    // Reproducció del bucle: forcePlay permet forçar l'estat en lloc de alternar-lo.
    function togglePlay(forcePlay) {
        if (timelineDates.length === 0) return;

        const shouldPlay = (typeof forcePlay === 'boolean') ? forcePlay : !isPlaying;
        isPlaying = shouldPlay;

        const btn = document.getElementById('btn-play');
        btn.textContent = isPlaying ? '⏸' : '▶';
        btn.setAttribute('aria-label', isPlaying ? 'Pausa' : 'Reprodueix');

        clearInterval(playInterval);
        clearTimeout(loopRestartTimeout);

        if (!isPlaying) return;

        // Si estàvem al final, reiniciem des del principi i renderitzem ja mateix
        // el primer fotograma (abans es saltava en el reinici del bucle).
        if (currentIndex >= CONFIG.TIMELINE_LENGTH - 1) {
            currentIndex = 0;
            document.getElementById('time-slider').value = currentIndex;
            renderActiveLayer();
        }

        playInterval = setInterval(() => {
            currentIndex++;
            if (currentIndex >= CONFIG.TIMELINE_LENGTH) {
                clearInterval(playInterval);
                currentIndex = CONFIG.TIMELINE_LENGTH - 1;
                document.getElementById('time-slider').value = currentIndex;
                renderActiveLayer();
                // Pausa breu mostrant l'últim fotograma abans de reiniciar el bucle
                loopRestartTimeout = setTimeout(() => {
                    if (isPlaying) togglePlay(true);
                }, CONFIG.LOOP_PAUSE_MS);
                return;
            }
            document.getElementById('time-slider').value = currentIndex;
            renderActiveLayer();
        }, CONFIG.ANIMATION_SPEED);
    }

    function clearCache() {
        for (let key in layerCache) {
            map.removeLayer(layerCache[key]);
        }
        layerCache = {};
        timelineDates = [];
        document.getElementById('time-slider').disabled = true;
    }

    function getTestUrl(date) {
        const testUrlTemplate = CONFIG.URLS[currentMode];
        let testUrl = formatUrl(testUrlTemplate, date);
        return testUrl.replace('{z}', '07').replace('{x}', '064').replace('{y}', '080');
    }

    function checkImageExists(url) {
        return new Promise((resolve) => {
            const img = new Image();
            img.onload = () => resolve(true);
            img.onerror = () => resolve(false);
            img.src = url;
        });
    }

    function formatUrl(template, date) {
        const pad = (n) => String(n).padStart(2, '0');
        const replacements = {
            '{any}': date.getUTCFullYear(),
            '{mes}': pad(date.getUTCMonth() + 1),
            '{dia}': pad(date.getUTCDate()),
            '{hora}': pad(date.getUTCHours()),
            '{minut}': pad(date.getUTCMinutes())
        };
        let url = template;
        for (const [key, value] of Object.entries(replacements)) {
            url = url.replaceAll(key, value);
        }
        return url;
    }

    function updateTimestampDisplay(date) {
        const display = document.getElementById('timestamp-display');
        const localTime = new Date(date);
        const pad = (n) => String(n).padStart(2, '0');
        const day = pad(localTime.getDate());
        const month = pad(localTime.getMonth() + 1);
        const hours = pad(localTime.getHours());
        const minutes = pad(localTime.getMinutes());

        display.textContent = `${day}/${month}/${localTime.getFullYear()} ${hours}:${minutes}`;
    }

    /* =========================================================
       CAPA DE SATÈL·LIT EN DIRECTE (núvols)
       ========================================================= */

    // Arrodoneix una data cap avall al múltiple de N minuts més proper (UTC),
    // que és la cadència amb què EUMETSAT publica nous fotogrames del MTG.
    function roundDownToStep(date, stepMinutes) {
        const d = new Date(date.getTime());
        const mins = d.getUTCMinutes();
        d.setUTCSeconds(0, 0);
        d.setUTCMinutes(mins - (mins % stepMinutes));
        return d;
    }

    // Crea (o reutilitza) la capa WMS corresponent a un fotograma concret.
    // El servidor de GeoServer d'EUMETSAT interpreta el paràmetre TIME amb
    // "nearestValue", és a dir, sempre retorna la imatge disponible més
    // propera a la marca de temps sol·licitada — no cal consultar-li primer
    // quins fotogrames existeixen.
    function getOrCreateSatelliteLayer(dateObj) {
        const iso = dateObj.toISOString().replace(/\.\d{3}Z$/, 'Z');
        if (!satelliteLayerCache[iso]) {
            const layer = L.tileLayer.wms(SATELLITE_CONFIG.WMS_URL, {
                layers: SATELLITE_CONFIG.LAYER,
                version: '1.3.0',
                format: 'image/png',
                transparent: true,
                time: iso,
                opacity: 0,
                zIndex: SATELLITE_CONFIG.Z_INDEX,
                attribution: 'Satèl·lit: EUMETSAT (Meteosat Third Generation, GeoColour)',
                className: 'satellite-tile',
                maxZoom: 20
            });
            // Marquem quan la capa ha acabat de descarregar les seves tessel·les,
            // per poder-la esperar abans de mostrar-la (vegeu renderActiveSatelliteFrame).
            layer._satLoaded = false;
            layer.once('load', () => { layer._satLoaded = true; });
            satelliteLayerCache[iso] = layer;
        }
        return { iso, layer: satelliteLayerCache[iso] };
    }

    // Evita acumular indefinidament capes WMS en memòria mentre l'usuari va
    // desplaçant el slider de temps; sempre conservem el fotograma actiu.
    function pruneSatelliteCache() {
        const keys = Object.keys(satelliteLayerCache).sort();
        while (keys.length > SATELLITE_CONFIG.MAX_CACHED_FRAMES) {
            const oldest = keys.shift();
            if (oldest === satelliteActiveTimeKey) continue;
            map.removeLayer(satelliteLayerCache[oldest]);
            delete satelliteLayerCache[oldest];
        }
    }

    // Mostra el fotograma de satèl·lit corresponent a la data activa del
    // slider (o l'instant actual si encara no hi ha línia de temps del
    // radar), arrodonit als 10 minuts de cadència del MTG.
    function renderActiveSatelliteFrame(activeDate) {
        if (!satelliteEnabled) return;

        const target = activeDate ? activeDate
            : (timelineDates.length > 0 ? timelineDates[currentIndex] : new Date());
        const frameDate = roundDownToStep(target, SATELLITE_CONFIG.STEP_MINUTES);
        const { iso, layer } = getOrCreateSatelliteLayer(frameDate);

        if (!map.hasLayer(layer)) layer.addTo(map);

        // Identificador de la sol·licitud: si l'usuari mou el slider abans que
        // aquest fotograma acabi de carregar, la crida següent incrementarà
        // el token i aquesta quedarà obsoleta i es descartarà en arribar.
        satelliteRequestToken++;
        const myToken = satelliteRequestToken;

        const applyFrame = () => {
            if (myToken !== satelliteRequestToken) return; // ja no és el fotograma vigent

            for (let key in satelliteLayerCache) {
                if (key === iso) {
                    satelliteLayerCache[key].setOpacity(currentSatelliteOpacity);
                    satelliteLayerCache[key].bringToFront();
                } else {
                    satelliteLayerCache[key].setOpacity(0);
                }
            }
            satelliteActiveTimeKey = iso;
            pruneSatelliteCache();

            // Reordenem perquè el satèl·lit quedi per sota del radar/pluja-neu
            // i dels límits administratius, però per sobre del mapa base.
            if (comarquesLayer) comarquesLayer.bringToFront();
            if (municipisLayer) municipisLayer.bringToFront();
            for (let key in layerCache) layerCache[key].bringToFront();
            if (userAccuracyCircle) userAccuracyCircle.bringToFront();
            if (userLocationMarker) userLocationMarker.bringToFront();

            const noteEl = document.getElementById('val-satellite-timestamp');
            if (noteEl) {
                const pad = (n) => String(n).padStart(2, '0');
                noteEl.textContent = `${pad(frameDate.getDate())}/${pad(frameDate.getMonth() + 1)} ${pad(frameDate.getHours())}:${pad(frameDate.getMinutes())}`;
            }
        };

        if (layer._satLoaded) {
            // Ja la teníem descarregada (normalment gràcies al precarregat):
            // podem canviar-hi a l'instant, sense esperar cap xarxa.
            applyFrame();
        } else {
            // Encara no s'ha descarregat aquest fotograma. En comptes de
            // deixar el mapa sense imatge de satèl·lit mentre arriba,
            // mantenim visible l'última que ja teníem (si n'hi ha) fins que
            // la nova estigui llesta, i aleshores fem el canvi.
            const noteEl = document.getElementById('val-satellite-timestamp');
            if (noteEl && satelliteActiveTimeKey && !noteEl.textContent.includes('actualitzant')) {
                noteEl.textContent += ' (actualitzant…)';
            }
            layer.once('load', applyFrame);
        }
    }

    // Precarrega totes les capes de satèl·lit corresponents a la línia de
    // temps actual del radar (deduplicant per fotograma de 10 min), afegint-
    // les al mapa amb opacitat 0. Així, quan l'usuari arrossega el slider de
    // temps, el fotograma corresponent ja sol estar carregat i el canvi és
    // instantani en lloc d'esperar la xarxa.
    function preloadSatelliteFrames() {
        if (!timelineDates || timelineDates.length === 0) return;
        const seen = new Set();
        timelineDates.forEach(date => {
            const frameDate = roundDownToStep(date, SATELLITE_CONFIG.STEP_MINUTES);
            const iso = frameDate.toISOString().replace(/\.\d{3}Z$/, 'Z');
            if (seen.has(iso)) return;
            seen.add(iso);
            const { layer } = getOrCreateSatelliteLayer(frameDate);
            if (!map.hasLayer(layer)) layer.addTo(map);
        });
        pruneSatelliteCache();
    }

    function enableSatellite() {
        satelliteEnabled = true;
        renderActiveSatelliteFrame();
        preloadSatelliteFrames();
        clearInterval(satelliteRefreshTimer);
        // Només cal refrescar periòdicament quan l'usuari està mirant l'instant
        // actual (sense línia de temps del radar activa); si està explorant
        // l'historial, ja és el propi slider qui determina el fotograma.
        satelliteRefreshTimer = setInterval(() => {
            if (!timelineDates || timelineDates.length === 0) renderActiveSatelliteFrame();
        }, SATELLITE_CONFIG.REFRESH_INTERVAL_MS);
    }

    function disableSatellite() {
        satelliteEnabled = false;
        clearInterval(satelliteRefreshTimer);
        satelliteRefreshTimer = null;
        for (let key in satelliteLayerCache) {
            map.removeLayer(satelliteLayerCache[key]);
        }
    }

    /* =========================================================
       UBICACIÓ DE L'USUARI: punt blau + cercle de precisió + con d'orientació
       ========================================================= */

    function buildUserLocationIcon() {
        return L.divIcon({
            className: 'user-location-marker-wrapper',
            html: `
                <div class="user-heading-cone"></div>
                <div class="user-location-pulse"></div>
                <div class="user-location-dot"></div>
            `,
            iconSize: [24, 24],
            iconAnchor: [12, 12]
        });
    }

    function getHeadingEventName() {
        // Android/Chrome exposa 'deviceorientationabsolute' amb rumb respecte al nord real.
        // Com a alternativa, 'deviceorientation' (a iOS porta webkitCompassHeading).
        if ('ondeviceorientationabsolute' in window) return 'deviceorientationabsolute';
        return 'deviceorientation';
    }

    function handleDeviceOrientation(event) {
        let heading = null;

        if (typeof event.webkitCompassHeading === 'number' && !isNaN(event.webkitCompassHeading)) {
            // iOS: ja ve com a azimut respecte al nord, en sentit horari (0-360)
            heading = event.webkitCompassHeading;
        } else if (typeof event.alpha === 'number' && !isNaN(event.alpha)) {
            // Android: alpha creix en sentit antihorari des de l'orientació inicial del dispositiu.
            // Amb l'esdeveniment "absolute" es pot convertir a rumb de brúixola aproximat.
            heading = 360 - event.alpha;
        }

        if (heading !== null) {
            deviceHeading = (heading + 360) % 360;
            updateMarkerHeading();
        }
    }

    function startCompass() {
        if (headingListenerActive) return;
        if (typeof window.DeviceOrientationEvent === 'undefined') return;

        headingEventName = getHeadingEventName();

        if (typeof DeviceOrientationEvent.requestPermission === 'function') {
            // iOS 13+: cal sol·licitar permís explícit, ha de ser en resposta directa a un gest de l'usuari
            DeviceOrientationEvent.requestPermission().then((response) => {
                if (response === 'granted') {
                    window.addEventListener(headingEventName, handleDeviceOrientation, true);
                    headingListenerActive = true;
                } else {
                    showNotice("No s'ha concedit permís per accedir a la brúixola del dispositiu.");
                }
            }).catch((err) => {
                console.error("Error demanant permís d'orientació:", err);
            });
        } else {
            window.addEventListener(headingEventName, handleDeviceOrientation, true);
            headingListenerActive = true;
        }
    }

    function stopCompass() {
        if (headingListenerActive && headingEventName) {
            window.removeEventListener(headingEventName, handleDeviceOrientation, true);
        }
        headingListenerActive = false;
        deviceHeading = null;
        updateMarkerHeading();
    }

    function updateMarkerHeading() {
        if (!userLocationMarker) return;
        const el = userLocationMarker.getElement();
        if (!el) return;
        const cone = el.querySelector('.user-heading-cone');
        if (!cone) return;

        if (deviceHeading !== null) {
            cone.classList.add('active');
            cone.style.transform = `rotate(${deviceHeading}deg)`;
        } else {
            cone.classList.remove('active');
        }
    }

    /* =========================================================
       PRECIPITACIÓ ACUMULADA EN UN PUNT (clic al mapa)
       Llegeix el color del píxel del radar de pluja a cada un dels
       11 fotogrames (1h, cada 6 min), el converteix a intensitat
       (mm/h) i integra l'acumulació. Mostra el total i una gràfica
       de l'evolució cada 10 minuts.
       ========================================================= */

    const PRECIP_ZOOM = 7; // zoom natiu de les dades del radar

    function padNum(v, len) {
        return String(v).padStart(len, '0');
    }

    // Converteix lat/lng a coordenades de tile fraccionàries (Web Mercator)
    function lonLatToTileFrac(lat, lon, z) {
        const n = Math.pow(2, z);
        const x = (lon + 180) / 360 * n;
        const latRad = lat * Math.PI / 180;
        const y = (1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2 * n;
        return { x, y, n };
    }

    function buildRainTileUrl(date, xtile, ytileTms, z) {
        let url = formatUrl(CONFIG.URLS.rain, date);
        url = url.replace('{z}', padNum(z, 2)).replace('{x}', padNum(xtile, 3)).replace('{y}', padNum(ytileTms, 3));
        return url;
    }

    // Busca l'hora vàlida més recent disponible per a un mode donat (rain/snow)
    async function findLatestTimestampForMode(mode) {
        const start = roundToInterval(new Date());
        const candidates = [];
        for (let i = 0; i < 5; i++) {
            candidates.push(new Date(start.getTime() - (i * CONFIG.INTERVAL_MINUTES * 60000)));
        }
        const checks = candidates.map(async (date) => {
            const testUrlTemplate = CONFIG.URLS[mode];
            let testUrl = formatUrl(testUrlTemplate, date);
            testUrl = testUrl.replace('{z}', '07').replace('{x}', '064').replace('{y}', '080');
            const exists = await checkImageExists(testUrl);
            return { date, exists };
        });
        const results = await Promise.all(checks);
        const winner = results.find(r => r.exists);
        return winner ? winner.date : null;
    }

    // Carrega un tile i llegeix el color del píxel (px, py) dins seu.
    // Retorna { status: 'ok', rgba } | { status: 'missing' } | { status: 'cors' }
    function readPixelFromTile(url, px, py) {
        return new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = () => {
                try {
                    const canvas = document.createElement('canvas');
                    canvas.width = 256;
                    canvas.height = 256;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, 256, 256);
                    const data = ctx.getImageData(px, py, 1, 1).data;
                    resolve({ status: 'ok', rgba: data });
                } catch (err) {
                    if (err && err.name === 'SecurityError') {
                        resolve({ status: 'cors' });
                    } else {
                        resolve({ status: 'error' });
                    }
                }
            };
            img.onerror = () => resolve({ status: 'missing' });
            img.src = url;
        });
    }

    // Converteix un color RGBA de píxel del radar a una intensitat estimada (mm/h)
    function rgbaToIntensity(rgba) {
        const r = rgba[0], g = rgba[1], b = rgba[2], a = rgba[3];
        if (a < 25) return 0; // píxel transparent = sense precipitació

        let minDist = Infinity;
        let bestIdx = 0;
        for (let i = 0; i < RAIN_COLOR_RGB.length; i++) {
            const c = RAIN_COLOR_RGB[i];
            const dist = (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2;
            if (dist < minDist) {
                minDist = dist;
                bestIdx = i;
            }
        }
        return RAIN_INTENSITY_MMH[bestIdx];
    }

    // Interpola linealment el valor acumulat en un instant (en minuts des de l'inici)
    function interpolateCumulative(cumulative, tMinutes, intervalMinutes) {
        const idxFloat = tMinutes / intervalMinutes;
        const idx = Math.floor(idxFloat);
        const frac = idxFloat - idx;
        if (idx >= cumulative.length - 1) return cumulative[cumulative.length - 1];
        return cumulative[idx] + (cumulative[idx + 1] - cumulative[idx]) * frac;
    }

    function formatHHMM(date) {
        const pad = (n) => String(n).padStart(2, '0');
        return `${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    function renderPrecipLoadingHtml() {
        return `
            <div class="precip-popup-content">
                <div class="precip-popup-title">💧 Precipitació acumulada</div>
                <div class="precip-loading-wrap">
                    <div class="precip-loading-spinner"></div>
                    <div class="precip-loading-text">Analitzant 11 imatges del radar...</div>
                </div>
            </div>
        `;
    }

    function renderPrecipResultHtml(totalMm, incomplete) {
        return `
            <div class="precip-popup-content">
                <div class="precip-popup-title">💧 Precipitació acumulada</div>
                <div class="precip-popup-total">${totalMm.toFixed(1)}<span> mm</span></div>
                <div class="precip-popup-subtitle">Última hora${incomplete ? ' · dades parcials' : ''}</div>
                <canvas id="precip-chart-canvas" width="270" height="130"></canvas>
                <div class="precip-popup-disclaimer">Estimació calculada a partir de la intensitat del radar de pluja de Meteocat (una imatge cada 6 min). No és una mesura directa de pluviòmetre.</div>
            </div>
        `;
    }

    function renderPrecipErrorHtml(message) {
        return `
            <div class="precip-popup-content">
                <div class="precip-popup-title">💧 Precipitació acumulada</div>
                <div class="precip-popup-error">${message}</div>
            </div>
        `;
    }

    async function calculatePrecipitationAtPoint(latlng) {
        const requestId = ++precipRequestId;

        if (precipChartInstance) {
            precipChartInstance.destroy();
            precipChartInstance = null;
        }

        precipPopup = L.popup({ maxWidth: 300, className: 'precip-popup' })
            .setLatLng(latlng)
            .setContent(renderPrecipLoadingHtml())
            .openOn(map);

        try {
            const latestRain = await findLatestTimestampForMode('rain');
            if (requestId !== precipRequestId) return;

            if (!latestRain) {
                precipPopup.setContent(renderPrecipErrorHtml("No s'han trobat dades recents del radar de pluja."));
                return;
            }

            const { x: xf, y: yf, n } = lonLatToTileFrac(latlng.lat, latlng.lng, PRECIP_ZOOM);
            const xtile = Math.floor(xf);
            const ytile = Math.floor(yf);
            const px = Math.min(255, Math.max(0, Math.floor((xf - xtile) * 256)));
            const py = Math.min(255, Math.max(0, Math.floor((yf - ytile) * 256)));
            const ytileTms = n - 1 - ytile;

            const frameCount = CONFIG.ACCUM_FRAME_COUNT; // 11 imatges = 1 hora
            const dates = [];
            for (let i = frameCount - 1; i >= 0; i--) {
                dates.push(new Date(latestRain.getTime() - i * CONFIG.INTERVAL_MINUTES * 60000));
            }

            const results = await Promise.all(
                dates.map(date => readPixelFromTile(buildRainTileUrl(date, xtile, ytileTms, PRECIP_ZOOM), px, py))
            );
            if (requestId !== precipRequestId) return;

            if (results.some(r => r.status === 'cors')) {
                precipPopup.setContent(renderPrecipErrorHtml("El servidor del radar no permet llegir les dades de píxel des del navegador (bloqueig CORS), així que no es pot calcular l'acumulació en aquest punt."));
                return;
            }

            let missingCount = 0;
            const intensities = results.map(r => {
                if (r.status === 'ok') return rgbaToIntensity(r.rgba);
                missingCount++;
                return 0;
            });

            // Integració trapezoidal: mm = mitjana d'intensitat entre dos fotogrames x (interval en hores)
            const cumulative = [0];
            for (let i = 0; i < intensities.length - 1; i++) {
                const avgIntensity = (intensities[i] + intensities[i + 1]) / 2;
                const add = avgIntensity * (CONFIG.INTERVAL_MINUTES / 60);
                cumulative.push(cumulative[cumulative.length - 1] + add);
            }
            const totalMm = cumulative[cumulative.length - 1];

            // Recalcula cada 10 minuts per a la gràfica
            const totalMinutes = (frameCount - 1) * CONFIG.INTERVAL_MINUTES; // 60 min = 1h
            const chartLabels = [];
            const chartValues = [];
            for (let t = 0; t <= totalMinutes; t += 10) {
                const value = interpolateCumulative(cumulative, t, CONFIG.INTERVAL_MINUTES);
                const labelDate = new Date(dates[0].getTime() + t * 60000);
                chartLabels.push(formatHHMM(labelDate));
                chartValues.push(Math.round(value * 10) / 10);
            }
            if (totalMinutes % 10 !== 0) {
                chartLabels.push(formatHHMM(dates[dates.length - 1]));
                chartValues.push(Math.round(totalMm * 10) / 10);
            }

            const incomplete = missingCount > 0;
            precipPopup.setContent(renderPrecipResultHtml(totalMm, incomplete));

            setTimeout(() => {
                if (requestId !== precipRequestId) return;
                const canvas = document.getElementById('precip-chart-canvas');
                if (!canvas || typeof Chart === 'undefined') return;
                precipChartInstance = new Chart(canvas.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: chartLabels,
                        datasets: [{
                            label: 'Acumulació (mm)',
                            data: chartValues,
                            borderColor: '#0084ff',
                            backgroundColor: 'rgba(0,132,255,0.15)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 2
                        }]
                    },
                    options: {
                        responsive: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, title: { display: true, text: 'mm' } },
                            x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 6 } }
                        }
                    }
                });
            }, 0);

        } catch (err) {
            console.error('Error calculant la precipitació:', err);
            if (requestId === precipRequestId && precipPopup) {
                precipPopup.setContent(renderPrecipErrorHtml("Hi ha hagut un error inesperat calculant la precipitació en aquest punt."));
            }
        }
    }

    /* =========================================================
       MAPA DE PLUJA ACUMULADA (overlay pixelat sobre tot Catalunya)
       Per a cada tile de radar que cobreix Catalunya, llegeix els
       píxels de les últimes 11 imatges (1h), n'integra la
       intensitat i pinta el resultat amb la gamma de colors del
       radar. Les zones sense pluja es pinten de gris. El resultat
       final es retalla amb el contorn de Catalunya (unió de comarques).
       ========================================================= */

    function loadTileImage(url) {
        return new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = url;
        });
    }

    // Igual que rgbaToIntensity però rebent components separats (evita crear arrays per píxel)
    function rgbaToIntensityFast(r, g, b) {
        let minDist = Infinity;
        let bestIdx = 0;
        for (let i = 0; i < RAIN_COLOR_RGB.length; i++) {
            const c = RAIN_COLOR_RGB[i];
            const dist = (r - c[0]) ** 2 + (g - c[1]) ** 2 + (b - c[2]) ** 2;
            if (dist < minDist) {
                minDist = dist;
                bestIdx = i;
            }
        }
        return RAIN_INTENSITY_MMH[bestIdx];
    }

    // mm acumulats -> color de la gamma del radar (o null si per sota del llindar mínim, es pintarà gris)
    function accumMmToColor(mm) {
        if (mm < ACCUM_BINS_MM[0]) return null;
        for (let i = 0; i < ACCUM_BINS_MM.length; i++) {
            if (mm < ACCUM_BINS_MM[i]) return RAIN_COLOR_RGB[i];
        }
        return RAIN_COLOR_RGB[RAIN_COLOR_RGB.length - 1];
    }

    // Inversa de lonLatToTileFrac: coordenades de tile fraccionàries -> lat/lng
    function tileFracToLatLng(x, y, z) {
        const n = Math.pow(2, z);
        const lon = (x / n) * 360 - 180;
        const latRad = Math.atan(Math.sinh(Math.PI * (1 - (2 * y) / n)));
        return { lat: (latRad * 180) / Math.PI, lng: lon };
    }

    function setAccumRainUiVisible(active, loading) {
        const loadingEl = document.getElementById('accum-rain-loading');
        const closeBtn = document.getElementById('accum-rain-close-btn');
        const titleBadge = document.getElementById('accum-rain-title-badge');
        const fullscreenBtn = document.getElementById('fullscreen-toggle');
        const searchContainer = document.querySelector('.search-container');
        const legendContainer = document.getElementById('legend-container');
        const accumOpacityControl = document.getElementById('accum-rain-opacity-control');
        // El menú general (desplegable) i la barra d'evolució del radar (timeline)
        // es mantenen sempre visibles i operatius, també amb la Pluja acumulada activa.

        if (active) {
            loadingEl.classList.toggle('hidden', !loading);
            closeBtn.classList.toggle('hidden', loading);
            titleBadge.classList.toggle('hidden', loading);
            if (fullscreenBtn) fullscreenBtn.classList.add('hidden');
            searchContainer.classList.add('hidden');
            accumOpacityControl.classList.toggle('hidden', loading);
            // Mentre la Pluja acumulada està activa, la llegenda mostra la seva
            // pròpia escala (en mm), però només si l'usuari té activat el checkbox
            // "Mostrar Llegenda" (igual que en la resta de modes).
            updateLegendUI('accum');
            const legendCbAccum = document.getElementById('toggle-legend');
            legendContainer.classList.toggle('hidden', loading || !legendCbAccum.checked);
        } else {
            loadingEl.classList.add('hidden');
            closeBtn.classList.add('hidden');
            titleBadge.classList.add('hidden');
            if (fullscreenBtn) fullscreenBtn.classList.remove('hidden');
            searchContainer.classList.remove('hidden');
            accumOpacityControl.classList.add('hidden');
            // Es restaura la llegenda del mode de radar/neu actiu i el seu estat habitual (segons el checkbox).
            updateLegendUI(currentMode);
            const legendCb = document.getElementById('toggle-legend');
            legendContainer.classList.toggle('hidden', !legendCb.checked);
        }
    }

    function setAccumRainButtonActive(active) {
        const btn = document.getElementById('btn-accum-rain');
        if (!btn) return;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
    }

    function closeAccumulatedRainMap() {
        accumRainRequestId++; // invalida qualsevol càlcul en curs
        if (accumRainOverlay) {
            map.removeLayer(accumRainOverlay);
            accumRainOverlay = null;
        }
        setAccumRainUiVisible(false);
        setAccumRainButtonActive(false);
    }

    async function generateAccumulatedRainMap() {
        const requestId = ++accumRainRequestId;

        if (accumRainOverlay) {
            map.removeLayer(accumRainOverlay);
            accumRainOverlay = null;
        }
        setAccumRainUiVisible(true, true);

        try {
            if (!catalunyaGeoJSONData) {
                showNotice("Encara s'estan carregant els límits de Catalunya. Torna-ho a provar en uns segons.");
                setAccumRainUiVisible(false);
                return;
            }

            const latestRain = await findLatestTimestampForMode('rain');
            if (requestId !== accumRainRequestId) return;
            if (!latestRain) {
                showNotice("No s'han trobat dades recents del radar per calcular l'acumulació.");
                setAccumRainUiVisible(false);
                return;
            }

            const frameCount = CONFIG.ACCUM_FRAME_COUNT; // 11 imatges (1 hora)
            const dates = [];
            for (let i = frameCount - 1; i >= 0; i--) {
                dates.push(new Date(latestRain.getTime() - i * CONFIG.INTERVAL_MINUTES * 60000));
            }

            const z = PRECIP_ZOOM;
            const bounds = comarquesLayer ? comarquesLayer.getBounds() : L.latLngBounds([40.45, 0.05], [42.95, 3.45]);

            const nwFrac = lonLatToTileFrac(bounds.getNorth(), bounds.getWest(), z);
            const seFrac = lonLatToTileFrac(bounds.getSouth(), bounds.getEast(), z);
            const n = nwFrac.n;

            const xtileMin = Math.floor(nwFrac.x);
            const xtileMax = Math.floor(seFrac.x);
            const ytileMin = Math.floor(nwFrac.y);
            const ytileMax = Math.floor(seFrac.y);

            const tilesX = xtileMax - xtileMin + 1;
            const tilesY = ytileMax - ytileMin + 1;
            const totalPxW = tilesX * 256;
            const totalPxH = tilesY * 256;

            const dataCanvas = document.createElement('canvas');
            dataCanvas.width = totalPxW;
            dataCanvas.height = totalPxH;
            const dataCtx = dataCanvas.getContext('2d');
            const outImageData = dataCtx.createImageData(totalPxW, totalPxH);
            const outData = outImageData.data;

            // Ompli tot de gris (s'anirà retallant després amb la màscara de Catalunya)
            for (let p = 0; p < outData.length; p += 4) {
                outData[p] = ACCUM_GRAY_RGB[0];
                outData[p + 1] = ACCUM_GRAY_RGB[1];
                outData[p + 2] = ACCUM_GRAY_RGB[2];
                outData[p + 3] = 255;
            }

            const tmpCanvas = document.createElement('canvas');
            tmpCanvas.width = 256;
            tmpCanvas.height = 256;
            const tmpCtx = tmpCanvas.getContext('2d');

            for (let tx = xtileMin; tx <= xtileMax; tx++) {
                for (let ty = ytileMin; ty <= ytileMax; ty++) {
                    if (requestId !== accumRainRequestId) return;

                    const ytileTms = n - 1 - ty;
                    const tileImgs = await Promise.all(
                        dates.map(date => loadTileImage(buildRainTileUrl(date, tx, ytileTms, z)))
                    );
                    if (requestId !== accumRainRequestId) return;

                    const cumulative = new Float32Array(256 * 256);
                    let prevIntensity = null;

                    for (let f = 0; f < tileImgs.length; f++) {
                        const img = tileImgs[f];
                        const intensity = new Float32Array(256 * 256);

                        if (img) {
                            tmpCtx.clearRect(0, 0, 256, 256);
                            tmpCtx.drawImage(img, 0, 0, 256, 256);
                            const frameData = tmpCtx.getImageData(0, 0, 256, 256).data;
                            for (let i = 0, p = 0; i < 65536; i++, p += 4) {
                                const a = frameData[p + 3];
                                if (a >= 25) {
                                    intensity[i] = rgbaToIntensityFast(frameData[p], frameData[p + 1], frameData[p + 2]);
                                }
                            }
                        }

                        if (prevIntensity) {
                            for (let i = 0; i < 65536; i++) {
                                const avg = (prevIntensity[i] + intensity[i]) / 2;
                                cumulative[i] += avg * (CONFIG.INTERVAL_MINUTES / 60);
                            }
                        }
                        prevIntensity = intensity;
                    }

                    const offsetX = (tx - xtileMin) * 256;
                    const offsetY = (ty - ytileMin) * 256;
                    for (let ly = 0; ly < 256; ly++) {
                        const outRowStart = (offsetY + ly) * totalPxW;
                        const rowStart = ly * 256;
                        for (let lx = 0; lx < 256; lx++) {
                            const mm = cumulative[rowStart + lx];
                            const color = accumMmToColor(mm);
                            if (color) {
                                const p = (outRowStart + offsetX + lx) * 4;
                                outData[p] = color[0];
                                outData[p + 1] = color[1];
                                outData[p + 2] = color[2];
                                outData[p + 3] = 255;
                            }
                        }
                    }
                }
            }

            if (requestId !== accumRainRequestId) return;
            dataCtx.putImageData(outImageData, 0, 0);

            // Màscara: unió de totes les comarques (= contorn de Catalunya)
            const maskCanvas = document.createElement('canvas');
            maskCanvas.width = totalPxW;
            maskCanvas.height = totalPxH;
            const maskCtx = maskCanvas.getContext('2d');
            maskCtx.fillStyle = '#000';

            function projectToCanvas(lon, lat) {
                const f = lonLatToTileFrac(lat, lon, z);
                return [(f.x - xtileMin) * 256, (f.y - ytileMin) * 256];
            }

            function drawRing(ring) {
                ring.forEach((coord, idx) => {
                    const [px, py] = projectToCanvas(coord[0], coord[1]);
                    if (idx === 0) maskCtx.moveTo(px, py);
                    else maskCtx.lineTo(px, py);
                });
                maskCtx.closePath();
            }

            (catalunyaGeoJSONData.features || []).forEach(feature => {
                const geom = feature.geometry;
                if (!geom) return;
                const polys = geom.type === 'Polygon' ? [geom.coordinates] :
                              (geom.type === 'MultiPolygon' ? geom.coordinates : []);
                polys.forEach(poly => {
                    maskCtx.beginPath();
                    poly.forEach(ring => drawRing(ring));
                    maskCtx.fill('evenodd');
                });
            });

            dataCtx.globalCompositeOperation = 'destination-in';
            dataCtx.drawImage(maskCanvas, 0, 0);
            dataCtx.globalCompositeOperation = 'source-over';

            const nwLatLng = tileFracToLatLng(xtileMin, ytileMin, z);
            const seLatLng = tileFracToLatLng(xtileMax + 1, ytileMax + 1, z);
            const imageBounds = L.latLngBounds(
                [seLatLng.lat, nwLatLng.lng],
                [nwLatLng.lat, seLatLng.lng]
            );

            if (requestId !== accumRainRequestId) return;

            const dataUrl = dataCanvas.toDataURL('image/png');
            accumRainOverlay = L.imageOverlay(dataUrl, imageBounds, {
                opacity: currentAccumRainOpacity,
                className: 'radar-pixelated',
                interactive: false,
                zIndex: 500
            }).addTo(map);

            setAccumRainUiVisible(true, false);
            setAccumRainButtonActive(true);

        } catch (err) {
            console.error('Error generant el mapa de pluja acumulada:', err);
            if (requestId === accumRainRequestId) {
                showNotice("Hi ha hagut un error calculant el mapa de pluja acumulada.");
                setAccumRainUiVisible(false);
                setAccumRainButtonActive(false);
            }
        }
    }

    /* =========================================================
       BUSCADOR DE LOCALITATS (NOMINATIM) I MARCADORS DE CERCA
       ========================================================= */

    const NOMINATIM_URL = 'https://nominatim.openstreetmap.org/search';
    const SEARCH_DEBOUNCE_MS = 450;
    const SEARCH_MIN_CHARS = 3;

    let searchDebounceTimer = null;
    let searchAbortController = null;
    let currentSuggestions = [];
    let highlightedSuggestionIndex = -1;

    // El marcador "temporal" (no fixat): només n'hi pot haver un alhora.
    // Els marcadors fixats es queden al mapa fins que l'usuari els elimina.
    let tempSearchMarker = null;
    const allSearchMarkers = new Set();

    function initSearch() {
        const input = document.getElementById('location-search');
        const clearBtn = document.getElementById('search-clear-btn');
        const suggestionsBox = document.getElementById('search-suggestions');

        input.addEventListener('input', () => {
            const query = input.value.trim();
            clearBtn.classList.toggle('visible', query.length > 0);

            clearTimeout(searchDebounceTimer);
            highlightedSuggestionIndex = -1;

            if (query.length < SEARCH_MIN_CHARS) {
                hideSuggestions();
                return;
            }

            searchDebounceTimer = setTimeout(() => {
                fetchSuggestions(query);
            }, SEARCH_DEBOUNCE_MS);
        });

        input.addEventListener('keydown', (e) => {
            if (!suggestionsBox.classList.contains('visible') || currentSuggestions.length === 0) {
                return;
            }
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                highlightedSuggestionIndex = Math.min(highlightedSuggestionIndex + 1, currentSuggestions.length - 1);
                renderSuggestionsHighlight();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                highlightedSuggestionIndex = Math.max(highlightedSuggestionIndex - 1, 0);
                renderSuggestionsHighlight();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                const idx = highlightedSuggestionIndex >= 0 ? highlightedSuggestionIndex : 0;
                if (currentSuggestions[idx]) selectSuggestion(currentSuggestions[idx]);
            } else if (e.key === 'Escape') {
                hideSuggestions();
            }
        });

        clearBtn.addEventListener('click', () => {
            input.value = '';
            clearBtn.classList.remove('visible');
            hideSuggestions();
            input.focus();
        });

        document.addEventListener('click', (e) => {
            const searchContainer = document.querySelector('.search-container');
            if (!searchContainer.contains(e.target)) {
                hideSuggestions();
            }
        });
    }

    async function fetchSuggestions(query) {
        const suggestionsBox = document.getElementById('search-suggestions');
        suggestionsBox.innerHTML = '<div class="suggestion-loading">Cercant...</div>';
        showSuggestionsBox();

        if (searchAbortController) {
            searchAbortController.abort();
        }
        searchAbortController = new AbortController();

        // Bias suau cap a Catalunya (sense limitar la cerca a la zona, bounded=0)
        const viewbox = '0.15,42.9,3.4,40.5';
        const params = new URLSearchParams({
            format: 'jsonv2',
            addressdetails: '1',
            limit: '6',
            q: query,
            viewbox: viewbox,
            bounded: '0',
            'accept-language': 'ca'
        });

        try {
            const response = await fetch(`${NOMINATIM_URL}?${params.toString()}`, {
                signal: searchAbortController.signal,
                headers: { 'Accept': 'application/json' }
            });
            if (!response.ok) throw new Error('Error de xarxa a Nominatim');
            const results = await response.json();
            currentSuggestions = results;
            renderSuggestions(results);
        } catch (err) {
            if (err.name === 'AbortError') return;
            console.error('Error cercant a Nominatim:', err);
            suggestionsBox.innerHTML = '<div class="suggestion-empty">Error en la cerca. Torna-ho a provar.</div>';
        }
    }

    function renderSuggestions(results) {
        const suggestionsBox = document.getElementById('search-suggestions');
        const input = document.getElementById('location-search');

        if (!results || results.length === 0) {
            suggestionsBox.innerHTML = '<div class="suggestion-empty">Cap resultat trobat.</div>';
            input.setAttribute('aria-expanded', 'true');
            return;
        }

        suggestionsBox.innerHTML = '';
        results.forEach((result, idx) => {
            const item = document.createElement('div');
            item.className = 'suggestion-item';
            item.setAttribute('role', 'option');
            item.dataset.index = idx;
            item.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>${escapeHtml(result.display_name)}</span>
            `;
            item.addEventListener('click', () => selectSuggestion(result));
            suggestionsBox.appendChild(item);
        });

        input.setAttribute('aria-expanded', 'true');
        showSuggestionsBox();
    }

    function renderSuggestionsHighlight() {
        const items = document.querySelectorAll('.suggestion-item');
        items.forEach((el, idx) => {
            el.classList.toggle('highlighted', idx === highlightedSuggestionIndex);
        });
        if (items[highlightedSuggestionIndex]) {
            items[highlightedSuggestionIndex].scrollIntoView({ block: 'nearest' });
        }
    }

    function showSuggestionsBox() {
        document.getElementById('search-suggestions').classList.add('visible');
    }

    function hideSuggestions() {
        document.getElementById('search-suggestions').classList.remove('visible');
        document.getElementById('location-search').setAttribute('aria-expanded', 'false');
        currentSuggestions = [];
        highlightedSuggestionIndex = -1;
    }

    function selectSuggestion(result) {
        const lat = parseFloat(result.lat);
        const lon = parseFloat(result.lon);
        if (isNaN(lat) || isNaN(lon)) return;

        const shortName = result.display_name.split(',')[0];
        const input = document.getElementById('location-search');
        input.value = shortName;
        document.getElementById('search-clear-btn').classList.add('visible');
        hideSuggestions();

        // Centrem el mapa: si hi ha bounding box la utilitzem per ajustar el zoom
        if (result.boundingbox && result.boundingbox.length === 4) {
            const bb = result.boundingbox.map(parseFloat);
            const bounds = L.latLngBounds([bb[0], bb[2]], [bb[1], bb[3]]);
            map.flyToBounds(bounds, { maxZoom: 14, duration: 0.8 });
        } else {
            map.flyTo([lat, lon], 13, { duration: 0.8 });
        }

        addSearchMarker(lat, lon, result.display_name);
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function buildMarkerHtml(label, isPinned) {
        const dotColor = isPinned ? '#F5A623' : '#E11D2E';
        return `
            <div class="pin-label">${escapeHtml(label)}</div>
            <div class="marker-menu">
                <button class="btn-remove" title="Eliminar" aria-label="Eliminar aquest punt">🗑️</button>
                <button class="btn-pin ${isPinned ? 'is-pinned' : ''}" title="${isPinned ? 'Fixat (clic per desfixar)' : 'Fixar'}" aria-label="${isPinned ? 'Desfixar aquest punt' : 'Fixar aquest punt'}">📌</button>
            </div>
            <div class="marker-dot" style="background:${dotColor};"></div>
        `;
    }

    function addSearchMarker(lat, lon, label) {
        // Si hi havia un marcador temporal (no fixat) sense fixar, el substituïm
        if (tempSearchMarker) {
            removeSearchMarker(tempSearchMarker);
        }

        const icon = L.divIcon({
            className: 'search-marker-icon',
            html: buildMarkerHtml(label, false),
            iconSize: [18, 18],
            iconAnchor: [9, 9]
        });

        const marker = L.marker([lat, lon], { icon, riseOnHover: true, zIndexOffset: 2000 }).addTo(map);
        marker._label = label;
        marker._pinned = false;

        attachMarkerEvents(marker);
        allSearchMarkers.add(marker);
        tempSearchMarker = marker;
        return marker;
    }

    function attachMarkerEvents(marker) {
        const el = marker.getElement();
        if (!el) return;

        const removeBtn = el.querySelector('.btn-remove');
        const pinBtn = el.querySelector('.btn-pin');

        if (removeBtn) {
            L.DomEvent.on(removeBtn, 'click', L.DomEvent.stop)
                .on(removeBtn, 'click', () => removeSearchMarker(marker));
        }
        if (pinBtn) {
            L.DomEvent.on(pinBtn, 'click', L.DomEvent.stop)
                .on(pinBtn, 'click', () => togglePinMarker(marker));
        }
        // Evita que el doble clic sobre el marcador faci zoom al mapa
        L.DomEvent.on(el, 'dblclick', L.DomEvent.stop);
    }

    function togglePinMarker(marker) {
        marker._pinned = !marker._pinned;

        if (marker._pinned) {
            // En fixar-se, deixa de ser el marcador temporal
            if (tempSearchMarker === marker) {
                tempSearchMarker = null;
            }
        } else {
            // En desfixar-se, torna a ser temporal (substituint qualsevol altre temporal)
            if (tempSearchMarker && tempSearchMarker !== marker) {
                removeSearchMarker(tempSearchMarker);
            }
            tempSearchMarker = marker;
        }

        marker.setIcon(L.divIcon({
            className: 'search-marker-icon',
            html: buildMarkerHtml(marker._label, marker._pinned),
            iconSize: [18, 18],
            iconAnchor: [9, 9]
        }));
        attachMarkerEvents(marker);
    }

    function removeSearchMarker(marker) {
        if (!marker) return;
        map.removeLayer(marker);
        allSearchMarkers.delete(marker);
        if (tempSearchMarker === marker) {
            tempSearchMarker = null;
        }
    }
    </script>
</body>
</html>
